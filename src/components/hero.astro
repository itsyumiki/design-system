---
// src/components/Hero.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    img: ImageMetadata;
}

const { img } = Astro.props;
---

<div class="hero">
    <div class="lens" data-lens>
        <Image
            src={img}
            alt="Hero Image"
            widths={[640, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            class="cover blur-load"
            draggable="false"
        />

        <!-- layer 1: dim + blur the base image on hover -->
        <div class="dim" aria-hidden="true"></div>

        <!-- layer 2: zoomed copy, revealed through a radial mask at the cursor -->
        <div class="zoom" aria-hidden="true">
            <Image
                src={img}
                alt=""
                widths={[640, 1280, 1920]}
                sizes="100vw"
                loading="eager"
                class="cover"
                draggable="false"
            />
        </div>
    </div>
</div>

<style>
    .hero {
        --lens-size: 170px;
        --zoom: 1.5;
        --ease-smooth: cubic-bezier(0.22, 1, 0.36, 1);
        position: relative;
    }

    /* ---------- lens ---------- */
    .lens {
        --x: -50%;
        --y: -50%;
        position: relative;
        overflow: hidden;
        border-radius: 0.5rem;
    }
    .cover {
        display: block;
        width: 100%;
        height: auto;
    }

    .dim,
    .zoom {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
    }

    .dim {
        background: rgb(0 0 0 / 0.25);
        backdrop-filter: blur(0px);
        transition:
            opacity 0.2s ease-out,
            backdrop-filter 0.3s ease-out;
    }

    .zoom {
        overflow: hidden;
        mask-image: radial-gradient(
            circle calc(var(--lens-size) / 2) at var(--x) var(--y),
            #000 80%,
            transparent 100%
        );
        /* grow from the cursor: scale and origin sit on the same masked element */
        transform: scale(0.58);
        transform-origin: var(--x) var(--y);
        transition:
            opacity 0.3s ease-out,
            transform 0.3s ease-out;
        will-change: transform, opacity;
    }

    .zoom :global(img) {
        width: 100%;
        height: 100%;
        object-fit: fill;
        transform: scale(var(--zoom));
        transform-origin: var(--x) var(--y);
    }

    /* only on devices with a real hover pointer */
    @media (hover: hover) {
        .lens:hover .dim,
        .lens:hover .zoom {
            opacity: 1;
        }
        .lens:hover .dim {
            backdrop-filter: blur(2px);
        }
        .lens:hover .zoom {
            transform: scale(1);
        }
    }
    @media (hover: none) {
        .dim,
        .zoom {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .dim,
        .zoom {
            transition: none;
        }
    }

    /* ---------- load-in blur ---------- */
    .blur-load {
        filter: blur(5px);
        transition: filter 0.5s var(--ease-smooth);
    }
    .blur-load:global(.loaded) {
        filter: blur(0);
    }
    /* if JS is off, never leave the image blurred */
    @media (scripting: none) {
        .cover {
            filter: none;
        }

        .blur-load {
            filter: none;
        }
    }
</style>

<script>
    // lens: feed pointer position to CSS (no re-render, no state)
    document.querySelectorAll<HTMLElement>("[data-lens]").forEach((el) => {
        const update = (e: PointerEvent) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty("--x", `${e.clientX - r.left}px`);
            el.style.setProperty("--y", `${e.clientY - r.top}px`);
        };
        el.addEventListener("pointerenter", update);
        el.addEventListener("pointermove", update);
    });

    // load-in blur: drop the blur once each image has loaded
    document
        .querySelectorAll<HTMLImageElement>("img.blur-load")
        .forEach((img) => {
            const done = () => img.classList.add("loaded");
            if (img.complete) done();
            else img.addEventListener("load", done, { once: true });
        });
</script>
